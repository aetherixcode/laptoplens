---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div id="app"></div>
</Layout>

<script type="module">
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
  const ADMIN_PASSWORD = import.meta.env.PUBLIC_ADMIN_PASSWORD;

  const app = document.getElementById("app");

  function showLogin() {
    app.innerHTML = `
      <div style="min-height:100dvh;display:flex;align-items:center;justify-content:center;background:#0f0f0f;padding:16px;">
        <div style="background:#1a1a1a;border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:40px;width:100%;max-width:380px;">
          <div style="text-align:center;margin-bottom:28px;">
            <div style="width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,#d4a03a,#b8860b);display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:20px;font-weight:700;color:#000;">L</div>
            <h1 style="color:#fff;font-size:20px;font-weight:600;margin:0;font-family:-apple-system,BlinkMacSystemFont,sans-serif;">Admin Access</h1>
            <p style="color:#888;font-size:13px;margin:6px 0 0;font-family:-apple-system,BlinkMacSystemFont,sans-serif;">Enter password to continue</p>
          </div>
          <div id="login-error" style="color:#ef4444;font-size:12px;text-align:center;margin-bottom:12px;display:none;font-family:-apple-system,BlinkMacSystemFont,sans-serif;"></div>
          <input id="password-input" type="password" placeholder="Password" style="width:100%;padding:12px 14px;border-radius:10px;border:1px solid rgba(255,255,255,0.1);background:#0f0f0f;color:#fff;font-size:14px;outline:none;box-sizing:border-box;margin-bottom:12px;">
          <button id="login-btn" style="width:100%;padding:12px;border-radius:10px;border:none;background:linear-gradient(135deg,#d4a03a,#b8860b);color:#000;font-size:14px;font-weight:600;cursor:pointer;">Access Dashboard</button>
        </div>
      </div>
    `;

    document.getElementById("login-btn").onclick = () => {
      const pw = document.getElementById("password-input").value;
      if (pw === ADMIN_PASSWORD) {
        sessionStorage.setItem("laptop_admin", "true");
        initDashboard();
      } else {
        const err = document.getElementById("login-error");
        err.textContent = "Incorrect password";
        err.style.display = "block";
      }
    };
    document.getElementById("password-input").onkeydown = (e) => {
      if (e.key === "Enter") document.getElementById("login-btn").click();
    };
  }

  const COLUMNS = [
    { key: "id", label: "ID", type: "number", readonly: true },
    { key: "name", label: "Name", type: "text", required: true },
    { key: "brand", label: "Brand", type: "text" },
    { key: "price", label: "Price", type: "number" },
    { key: "original_price", label: "Original Price", type: "number" },
    { key: "image_url", label: "Image URL", type: "text" },
    { key: "product_url", label: "Product URL", type: "text" },
    { key: "processor", label: "Processor", type: "text" },
    { key: "ram", label: "RAM", type: "text" },
    { key: "storage", label: "Storage", type: "text" },
    { key: "gpu", label: "GPU", type: "text" },
    { key: "display_size", label: "Display Size", type: "text" },
    { key: "os", label: "OS", type: "text" },
    { key: "rating", label: "Rating", type: "number", step: "0.1" },
    { key: "ratings_count", label: "Ratings Count", type: "number" },
    { key: "gaming_score", label: "Gaming", type: "number" },
    { key: "battery_score", label: "Battery", type: "number" },
    { key: "coding_score", label: "Coding", type: "number" },
    { key: "editing_score", label: "Editing", type: "number" },
    { key: "portability_score", label: "Portability", type: "number" },
    { key: "student_score", label: "Student", type: "number" },
    { key: "performance_score", label: "Performance", type: "number" },
    { key: "tags", label: "Tags", type: "text" },
    { key: "created_at", label: "Created", type: "text", readonly: true },
    { key: "updated_at", label: "Updated", type: "text", readonly: true },
  ];

  const VISIBLE_COLUMNS = ["id", "name", "brand", "price", "processor", "ram", "storage", "rating"];

  let laptops = [];
  let showForm = false;
  let editingId = null;

  async function fetchLaptops() {
    try {
      const res = await fetch(`${SUPABASE_URL}/rest/v1/laptops?order=id.desc`, {
        headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` },
      });
      laptops = await res.json();
      renderTable();
    } catch (e) {
      console.error(e);
    }
  }

  async function deleteLaptop(id) {
    if (!confirm("Delete this laptop?")) return;
    try {
      await fetch(`${SUPABASE_URL}/rest/v1/laptops?id=eq.${id}`, {
        method: "DELETE",
        headers: { apikey: SUPABASE_KEY, Authorization: `Bearer ${SUPABASE_KEY}` },
      });
      await fetchLaptops();
    } catch (e) {
      console.error(e);
    }
  }

  async function saveLaptop(data) {
    const method = editingId ? "PATCH" : "POST";
    const url = editingId
      ? `${SUPABASE_URL}/rest/v1/laptops?id=eq.${editingId}`
      : `${SUPABASE_URL}/rest/v1/laptops`;

    const body = { ...data };
    if (editingId) delete body.id;
    if (body.tags && typeof body.tags === "string") {
      body.tags = body.tags.split(",").map((t) => t.trim()).filter(Boolean);
    }

    try {
      await fetch(url, {
        method,
        headers: {
          apikey: SUPABASE_KEY,
          Authorization: `Bearer ${SUPABASE_KEY}`,
          "Content-Type": "application/json",
          Prefer: "return=minimal",
        },
        body: JSON.stringify(body),
      });
      showForm = false;
      editingId = null;
      document.getElementById("form-container").innerHTML = "";
      await fetchLaptops();
    } catch (e) {
      console.error(e);
    }
  }

  function initDashboard() {
    app.innerHTML = `
      <div style="min-height:100dvh;background:#0f0f0f;padding:24px;">
        <div style="max-width:1400px;margin:0 auto;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
            <div>
              <h1 style="color:#fff;font-size:24px;font-weight:600;margin:0;font-family:-apple-system,BlinkMacSystemFont,sans-serif;">Laptops Admin</h1>
              <p style="color:#888;font-size:13px;margin:4px 0 0;font-family:-apple-system,BlinkMacSystemFont,sans-serif;"><span id="count">0</span> laptops</p>
            </div>
            <div style="display:flex;gap:8px;">
              <button id="refresh-btn" style="padding:10px 18px;border-radius:10px;border:1px solid rgba(255,255,255,0.1);background:transparent;color:#ccc;font-size:13px;cursor:pointer;">↻ Refresh</button>
              <button id="add-btn" style="padding:10px 18px;border-radius:10px;border:none;background:linear-gradient(135deg,#d4a03a,#b8860b);color:#000;font-size:13px;font-weight:600;cursor:pointer;">+ Add Laptop</button>
            </div>
          </div>
          <div id="form-container"></div>
          <div id="table-container" style="overflow-x:auto;border:1px solid rgba(255,255,255,0.06);border-radius:12px;background:#1a1a1a;"></div>
        </div>
      </div>
    `;
    document.getElementById("refresh-btn").onclick = fetchLaptops;
    document.getElementById("add-btn").onclick = () => {
      editingId = null;
      showForm = true;
      renderForm({});
    };
    fetchLaptops();
  }

  function renderTable() {
    const container = document.getElementById("table-container");
    document.getElementById("count").textContent = laptops.length;

    if (!laptops.length) {
      container.innerHTML = `<div style="text-align:center;padding:48px;color:#666;font-size:14px;font-family:-apple-system,BlinkMacSystemFont,sans-serif;">No laptops found</div>`;
      return;
    }

    let html = `<table style="width:100%;border-collapse:collapse;font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:12px;">
      <thead><tr style="background:#0f0f0f;">`;
    VISIBLE_COLUMNS.forEach((key) => {
      const col = COLUMNS.find((c) => c.key === key);
      html += `<th style="padding:10px 12px;text-align:left;color:#888;font-weight:500;white-space:nowrap;border-bottom:1px solid rgba(255,255,255,0.06);">${col?.label || key}</th>`;
    });
    html += `<th style="padding:10px 12px;text-align:center;color:#888;font-weight:500;border-bottom:1px solid rgba(255,255,255,0.06);">Actions</th></tr></thead><tbody>`;

    laptops.forEach((lap) => {
      html += `<tr style="border-bottom:1px solid rgba(255,255,255,0.04);">`;
      VISIBLE_COLUMNS.forEach((key) => {
        let val = lap[key];
        if ((key === "price" || key === "original_price") && val) {
          val = "₹" + Number(val).toLocaleString("en-IN");
        } else if (key === "rating" && val) {
          val = "★ " + val;
        } else if (key === "image_url" && val) {
          val = `<img src="${val}" alt="" style="width:32px;height:32px;border-radius:6px;object-fit:cover;vertical-align:middle;" />`;
        } else if (Array.isArray(val)) {
          val = val.join(", ");
        }
        html += `<td style="padding:10px 12px;color:#ddd;white-space:nowrap;max-width:200px;overflow:hidden;text-overflow:ellipsis;">${val ?? "-"}</td>`;
      });
      html += `<td style="padding:10px 12px;text-align:center;white-space:nowrap;">
        <button class="edit-btn" data-id="${lap.id}" style="padding:5px 10px;border-radius:6px;border:1px solid rgba(255,255,255,0.1);background:transparent;color:#aaa;font-size:11px;cursor:pointer;margin-right:4px;">Edit</button>
        <button class="del-btn" data-id="${lap.id}" style="padding:5px 10px;border-radius:6px;border:1px solid rgba(239,68,68,0.3);background:transparent;color:#ef4444;font-size:11px;cursor:pointer;">Delete</button>
      </td></tr>`;
    });
    html += `</tbody></table>`;
    container.innerHTML = html;

    container.querySelectorAll(".edit-btn").forEach((btn) => {
      btn.onclick = () => {
        const id = Number(btn.dataset.id);
        const lap = laptops.find((l) => l.id === id);
        if (lap) {
          editingId = id;
          showForm = true;
          renderForm(lap);
        }
      };
    });
    container.querySelectorAll(".del-btn").forEach((btn) => {
      btn.onclick = () => deleteLaptop(Number(btn.dataset.id));
    });
  }

  function renderForm(data) {
    const container = document.getElementById("form-container");
    const isEdit = !!editingId;

    let html = `
      <div style="border:1px solid rgba(255,255,255,0.08);border-radius:12px;background:#1a1a1a;padding:24px;margin-bottom:20px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
          <h2 style="color:#fff;font-size:16px;font-weight:600;margin:0;font-family:-apple-system,BlinkMacSystemFont,sans-serif;">${isEdit ? "Edit Laptop" : "Add Laptop"}</h2>
          <button id="form-close" style="padding:6px 12px;border-radius:6px;border:1px solid rgba(255,255,255,0.1);background:transparent;color:#888;font-size:12px;cursor:pointer;">✕ Close</button>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;">
    `;

    COLUMNS.forEach((col) => {
      if (col.readonly) return;
      const val = data[col.key] ?? "";
      if (col.key === "tags") {
        const tagVal = Array.isArray(data.tags) ? data.tags.join(", ") : "";
        html += `<div style="display:flex;flex-direction:column;gap:4px;">
          <label style="color:#888;font-size:11px;font-family:-apple-system,BlinkMacSystemFont,sans-serif;">${col.label} (comma-separated)</label>
          <input type="text" id="field-${col.key}" value="${tagVal}" placeholder="${col.label}" style="padding:10px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.08);background:#0f0f0f;color:#fff;font-size:13px;outline:none;" />
        </div>`;
      } else {
        html += `<div style="display:flex;flex-direction:column;gap:4px;">
          <label style="color:#888;font-size:11px;font-family:-apple-system,BlinkMacSystemFont,sans-serif;">${col.label}</label>
          <input type="${col.type}" id="field-${col.key}" value="${String(val).replace(/"/g, "&quot;")}" placeholder="${col.label}" step="${col.step || ""}" style="padding:10px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.08);background:#0f0f0f;color:#fff;font-size:13px;outline:none;" />
        </div>`;
      }
    });

    html += `</div>
        <div style="display:flex;gap:8px;margin-top:16px;justify-content:flex-end;">
          <button id="form-cancel" style="padding:10px 20px;border-radius:8px;border:1px solid rgba(255,255,255,0.1);background:transparent;color:#aaa;font-size:13px;cursor:pointer;">Cancel</button>
          <button id="form-save" style="padding:10px 20px;border-radius:8px;border:none;background:linear-gradient(135deg,#d4a03a,#b8860b);color:#000;font-size:13px;font-weight:600;cursor:pointer;">${isEdit ? "Update" : "Create"}</button>
        </div>
      </div>`;

    container.innerHTML = html;

    const closeForm = () => {
      showForm = false;
      editingId = null;
      container.innerHTML = "";
      window.scrollTo({ top: 0, behavior: "smooth" });
    };
    document.getElementById("form-close").onclick = closeForm;
    document.getElementById("form-cancel").onclick = closeForm;
    document.getElementById("form-save").onclick = () => {
      const formData = {};
      COLUMNS.forEach((col) => {
        if (col.readonly) return;
        const el = document.getElementById(`field-${col.key}`);
        if (!el) return;
        let val = el.value;
        if (col.type === "number" && val) val = Number(val);
        formData[col.key] = val || null;
      });
      saveLaptop(formData);
    };
    container.scrollIntoView({ behavior: "smooth" });
  }

  if (sessionStorage.getItem("laptop_admin") === "true") {
    initDashboard();
  } else {
    showLogin();
  }
</script>

<style>
  * { box-sizing: border-box; }
  body { margin: 0; background: #0f0f0f; }
  input:focus { border-color: #d4a03a !important; }
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: #0f0f0f; }
  ::-webkit-scrollbar-thumb { background: #333; border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: #555; }
  table { min-width: 900px; }
  tr:hover { background: rgba(255,255,255,0.03); }
</style>
